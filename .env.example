# Local development credentials only. Change locally; never reuse in deployment.
POSTGRES_DB=fraud_rule_engine
POSTGRES_USER=fraud_rule_engine
POSTGRES_PASSWORD=local-only-change-this
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fraud_rule_engine
SPRING_DATASOURCE_USERNAME=fraud_rule_engine
SPRING_DATASOURCE_PASSWORD=local-only-change-this
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_PORT=19092
APP_PORT=8080
WEB_PORT=4200
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-only-change-this
# Reserve this subnet for the local monitoring network; Prometheus uses this fixed address.
MONITORING_SUBNET=172.30.0.0/24
PROMETHEUS_METRICS_IP=172.30.0.10
# Application-managed JWTs for synthetic assessment use. Compose enables this mode.
# Generate each secret separately with `openssl rand -base64 32` and set only in .env.
# Empty signing keys fail startup; no shared signing key or default admin is provided.
FRAUD_SECURITY_LOCAL_AUTH_ENABLED=true
FRAUD_SECURITY_LOCAL_AUTH_ISSUER=http://localhost:8080
FRAUD_SECURITY_LOCAL_AUTH_AUDIENCE=fraud-rule-engine-api
FRAUD_SECURITY_LOCAL_AUTH_SIGNING_KEY_BASE64=
FRAUD_SECURITY_LOCAL_AUTH_BOOTSTRAP_TOKEN=
FRAUD_SECURITY_LOCAL_AUTH_ACCESS_TOKEN_LIFETIME=PT5M
# Optional credentials for scripts/get-token.sh and scripts/demo.py.
# Create these users through bootstrap/admin APIs; no demo users are seeded.
DEMO_ADMIN_EMAIL=admin@example.test
DEMO_ADMIN_PASSWORD=
DEMO_ANALYST_EMAIL=analyst@example.test
DEMO_ANALYST_PASSWORD=
DEMO_AUDITOR_EMAIL=auditor@example.test
DEMO_AUDITOR_PASSWORD=
# Synthetic local use only: anonymous Swagger UI and OpenAPI docs. Never enable in deployment.
FRAUD_DOCS_ENABLED=true

# Grafana alert notifications (local Mailpit sink; swap for a real SMTP server and recipient)
FRAUD_ALERT_EMAIL_TO=fraud-ops@example.invalid
MAILPIT_PORT=8025
