{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/fraud-rule-engine/events/v1/transaction-event-dlq.schema.json",
  "title": "Synthetic assessment transaction dead-letter envelope",
  "description": "Sensitive assessment-only record for invalid or exhausted transaction event processing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "failureReasonCode",
    "sourceTopic",
    "sourcePartition",
    "sourceOffset",
    "failedAt",
    "deliveryAttempts",
    "eventId",
    "correlationId",
    "originalPayloadBase64"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "failureReasonCode": {
      "type": "string",
      "enum": [
        "INVALID_EVENT_SIZE",
        "INVALID_EVENT",
        "INVALID_MESSAGE_KEY",
        "EVENT_ID_CONFLICT",
        "RULE_CONFIGURATION_INVALID",
        "RULE_CONFIGURATION_MISSING",
        "RULE_EVALUATION_FAILED",
        "INVALID_EVENT_TIME",
        "PROCESSING_RETRIES_EXHAUSTED"
      ]
    },
    "sourceTopic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 249
    },
    "sourcePartition": {
      "type": "integer",
      "minimum": 0
    },
    "sourceOffset": {
      "type": "integer",
      "minimum": 0
    },
    "failedAt": {
      "type": "string",
      "format": "date-time"
    },
    "deliveryAttempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "eventId": {
      "type": ["string", "null"],
      "maxLength": 128
    },
    "correlationId": {
      "type": ["string", "null"],
      "maxLength": 128
    },
    "originalPayloadBase64": {
      "type": "string",
      "maxLength": 87384,
      "contentEncoding": "base64"
    }
  }
}
