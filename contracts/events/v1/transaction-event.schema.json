{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/fraud-rule-engine/events/v1/transaction-event.schema.json",
  "title": "Synthetic assessment transaction event",
  "description": "Proposed assessment-only contract. It is not an upstream producer guarantee.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "transactionId",
    "amount",
    "currency",
    "category",
    "occurredAt",
    "schemaVersion"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001F\\u007F]*\\S[^\\u0000-\\u001F\\u007F]*$"
    },
    "transactionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001F\\u007F]*\\S[^\\u0000-\\u001F\\u007F]*$"
    },
    "accountId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001F\\u007F]*\\S[^\\u0000-\\u001F\\u007F]*$"
    },
    "customerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001F\\u007F]*\\S[^\\u0000-\\u001F\\u007F]*$"
    },
    "amount": {
      "type": "number",
      "minimum": 0,
      "maximum": 99999999999999999999.999999999999999999,
      "multipleOf": 0.000000000000000001
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "category": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!0000-)[0-9]{4}-[0-9]{2}-[0-9]{2}T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "merchantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001F\\u007F]*\\S[^\\u0000-\\u001F\\u007F]*$"
    },
    "location": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "beneficiaryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "originCountry": {
      "type": "string",
      "pattern": "^[A-Za-z]{2}$"
    },
    "beneficiaryCountry": {
      "type": "string",
      "pattern": "^[A-Za-z]{2}$"
    },
    "channel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    }
  },
  "oneOf": [
    {
      "required": ["accountId"],
      "not": {
        "required": ["customerId"]
      }
    },
    {
      "required": ["customerId"],
      "not": {
        "required": ["accountId"]
      }
    }
  ]
}
