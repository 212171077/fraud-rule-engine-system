{
  "uid": "fraud-service-reliability",
  "title": "Service Reliability",
  "description": "HTTP availability, latency, JVM resource pressure and PostgreSQL connection-pool health. Synthetic assessment defaults, not production SLOs.",
  "tags": ["fraud-rule-engine", "reliability", "assessment"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "links": [
    {"title": "Fraud Operations", "type": "link", "url": "/d/fraud-operations", "keepTime": true},
    {"title": "Kafka Processing", "type": "link", "url": "/d/fraud-kafka-processing", "keepTime": true},
    {"title": "Alert rules", "type": "link", "url": "/alerting/list"}
  ],
  "panels": [
    {
      "id": 1, "type": "text", "title": "Service health at a glance",
      "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0},
      "options": {"mode": "markdown", "content": "**SYNTHETIC ASSESSMENT**  |  Start with scrape status, then HTTP errors and latency, then resource pressure.\n\nHTTP panels exclude `/actuator/**` polling so health checks do not hide API errors. Blank is missing data or idle traffic, not proof of health. Scrape availability is not application readiness or database health. Thresholds are assessment defaults, not production SLOs."}
    },
    {
      "id": 2, "type": "stat", "title": "Application scrape | now",
      "description": "Worst current application scrape status. DOWN means at least one configured target cannot be scraped. NO DATA means the target series is missing. This is not a readiness check.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 4},
      "targets": [{"refId": "A", "expr": "min(up{job=\"fraud-rule-engine\"})", "instant": true}],
      "fieldConfig": {"defaults": {"noValue": "NO DATA", "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}, {"type": "special", "options": {"match": "null+nan", "result": {"text": "NO DATA", "color": "gray"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "color": {"mode": "thresholds"}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 3, "type": "stat", "title": "HTTP requests / second",
      "description": "Current non-Actuator HTTP throughput over Grafana's adaptive rate window, including auth and documentation routes.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 4},
      "targets": [{"refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{application=\"fraud-rule-engine\",uri!~\"/actuator.*\"}[$__rate_interval]))", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 2, "noValue": "No samples", "mappings": [{"type": "special", "options": {"match": "null+nan", "result": {"text": "No samples", "color": "gray"}}}], "color": {"mode": "fixed", "fixedColor": "blue"}}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "text": {"valueSize": 52}, "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 4, "type": "stat", "title": "HTTP 5xx share | 5m",
      "description": "Server errors / all non-Actuator requests over 5m. No denominator clamping: a single failed low-traffic request is still 100%. Blank if there is no traffic.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 4},
      "targets": [{"refId": "A", "expr": "(sum(rate(http_server_requests_seconds_count{application=\"fraud-rule-engine\",uri!~\"/actuator.*\",status=~\"5..\"}[5m])) or (0 * sum(rate(http_server_requests_seconds_count{application=\"fraud-rule-engine\",uri!~\"/actuator.*\"}[5m])))) / (sum(rate(http_server_requests_seconds_count{application=\"fraud-rule-engine\",uri!~\"/actuator.*\"}[5m])) > 0)", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "decimals": 1, "noValue": "No samples", "mappings": [{"type": "special", "options": {"match": "null+nan", "result": {"text": "No samples", "color": "gray"}}}], "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.05}, {"color": "red", "value": 0.2}]}}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "text": {"valueSize": 52}, "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 5, "type": "stat", "title": "HTTP latency p95",
      "description": "Histogram estimate: 95% of observed non-Actuator requests finish at or below this duration. Blank while idle.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 4},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"fraud-rule-engine\",uri!~\"/actuator.*\"}[$__rate_interval])))", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "noValue": "No samples", "mappings": [{"type": "special", "options": {"match": "null+nan", "result": {"text": "No samples", "color": "gray"}}}], "color": {"mode": "fixed", "fixedColor": "purple"}}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "text": {"valueSize": 52}, "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 6, "type": "row", "title": "HTTP traffic and user experience", "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9}
    },
    {
      "id": 7, "type": "timeseries", "title": "HTTP throughput by status",
      "description": "Non-Actuator requests per second by HTTP status code. 4xx includes expected authentication and validation rejections; it is not necessarily a service failure.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 10},
      "targets": [{"refId": "A", "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"fraud-rule-engine\",uri!~\"/actuator.*\"}[$__rate_interval]))", "legendFormat": "{{status}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0, "noValue": "No samples", "custom": {"lineWidth": 2, "fillOpacity": 12, "spanNulls": false}}, "overrides": [
        {"matcher": {"id": "byRegexp", "options": "^5..$"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]},
        {"matcher": {"id": "byRegexp", "options": "^4..$"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]}
      ]},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 8, "type": "timeseries", "title": "HTTP latency | p50 / p95 / p99",
      "description": "Histogram percentiles for non-Actuator routes. Includes auth and documentation requests. Percentiles are estimates, not exact maxima.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 10},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"fraud-rule-engine\",uri!~\"/actuator.*\"}[$__rate_interval])))", "legendFormat": "p50"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"fraud-rule-engine\",uri!~\"/actuator.*\"}[$__rate_interval])))", "legendFormat": "p95"},
        {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"fraud-rule-engine\",uri!~\"/actuator.*\"}[$__rate_interval])))", "legendFormat": "p99"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "noValue": "No samples", "custom": {"lineWidth": 2, "spanNulls": false}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 9, "type": "row", "title": "JVM and database pressure", "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 18}
    },
    {
      "id": 10, "type": "timeseries", "title": "JVM heap | used / committed",
      "description": "Heap bytes across memory pools. Committed memory is allocated to the JVM, not a container limit.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 19},
      "targets": [
        {"refId": "A", "expr": "sum(jvm_memory_used_bytes{application=\"fraud-rule-engine\",area=\"heap\"})", "legendFormat": "Used"},
        {"refId": "B", "expr": "sum(jvm_memory_committed_bytes{application=\"fraud-rule-engine\",area=\"heap\"})", "legendFormat": "Committed"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0, "noValue": "No samples", "custom": {"lineWidth": 2, "fillOpacity": 10, "spanNulls": false}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 11, "type": "timeseries", "title": "CPU utilisation | process / system",
      "description": "JVM process and JVM-reported system CPU usage. System scope depends on JVM/container support; this is not per-host capacity accounting.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 19},
      "targets": [
        {"refId": "A", "expr": "process_cpu_usage{application=\"fraud-rule-engine\"}", "legendFormat": "Process {{instance}}"},
        {"refId": "B", "expr": "system_cpu_usage{application=\"fraud-rule-engine\"}", "legendFormat": "System {{instance}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "noValue": "No samples", "custom": {"lineWidth": 2, "spanNulls": false}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 12, "type": "timeseries", "title": "GC pause time per second",
      "description": "Sum of recorded stop-the-world pause durations / elapsed time. Separate from thread count so incompatible units are not mixed.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 19},
      "targets": [{"refId": "A", "expr": "sum(rate(jvm_gc_pause_seconds_sum{application=\"fraud-rule-engine\"}[$__rate_interval]))", "legendFormat": "Pause seconds / second"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "noValue": "No samples", "custom": {"lineWidth": 2, "fillOpacity": 15, "spanNulls": false}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 13, "type": "timeseries", "title": "Database pool | active / idle / waiting / max",
      "description": "Pool state by instance and pool. Waiting threads indicate acquisition pressure, not a proven database outage. Investigate long transactions and database reachability.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 27},
      "targets": [
        {"refId": "A", "expr": "hikaricp_connections_active{application=\"fraud-rule-engine\"}", "legendFormat": "Active {{instance}} / {{pool}}"},
        {"refId": "B", "expr": "hikaricp_connections_idle{application=\"fraud-rule-engine\"}", "legendFormat": "Idle {{instance}} / {{pool}}"},
        {"refId": "C", "expr": "hikaricp_connections_pending{application=\"fraud-rule-engine\"}", "legendFormat": "Waiting {{instance}} / {{pool}}"},
        {"refId": "D", "expr": "hikaricp_connections_max{application=\"fraud-rule-engine\"}", "legendFormat": "Max {{instance}} / {{pool}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "decimals": 0, "noValue": "No samples", "custom": {"lineWidth": 2, "spanNulls": false}}, "overrides": [
        {"matcher": {"id": "byRegexp", "options": "^Waiting .*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}
      ]},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 14, "type": "timeseries", "title": "JVM threads by state",
      "description": "Thread states help distinguish runnable work from waiting or blocked threads. Waiting threads alone do not indicate a fault.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 27},
      "targets": [{"refId": "A", "expr": "sum by (state) (jvm_threads_states_threads{application=\"fraud-rule-engine\"})", "legendFormat": "{{state}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "decimals": 0, "noValue": "No samples", "custom": {"lineWidth": 2, "fillOpacity": 12, "spanNulls": false}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 15, "type": "timeseries", "title": "Database connection acquisition | mean wait",
      "description": "Mean time to acquire a connection across pools, not query execution time. Compare with waiting threads. Blank if there were no acquisitions.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 35},
      "targets": [{"refId": "A", "expr": "sum(rate(hikaricp_connections_acquire_seconds_sum{application=\"fraud-rule-engine\"}[$__rate_interval])) / (sum(rate(hikaricp_connections_acquire_seconds_count{application=\"fraud-rule-engine\"}[$__rate_interval])) > 0)", "legendFormat": "Mean wait"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "noValue": "No samples", "custom": {"lineWidth": 2, "spanNulls": false}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 16, "type": "stat", "title": "Connection acquisition timeouts | selected range",
      "description": "Estimated HikariCP connection acquisition timeouts in the selected range. These are not all database errors.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 35},
      "targets": [{"refId": "A", "expr": "sum(increase(hikaricp_connections_timeout_total{application=\"fraud-rule-engine\"}[$__range]))", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 1, "noValue": "No samples", "mappings": [{"type": "special", "options": {"match": "null+nan", "result": {"text": "No samples", "color": "gray"}}}], "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.01}]}}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
    }
  ]
}
